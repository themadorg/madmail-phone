    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="Madmail" android:theme="@style/Theme.Madmail" android:supportsRtl="true" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config">
